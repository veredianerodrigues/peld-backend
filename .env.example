HOST=0.0.0.0
PORT=1337
# Produção: URL pública da API e proxy HTTPS
# PUBLIC_URL=https://api.seudominio.com.br
# IS_PROXIED=true
APP_KEYS=changeMe1,changeMe2,changeMe3,changeMe4
API_TOKEN_SALT=changeMe
ADMIN_JWT_SECRET=changeMe
TRANSFER_TOKEN_SALT=changeMe
JWT_SECRET=changeMe
ENCRYPTION_KEY=changeMe

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Para produção com MySQL (ex: Hostinger), troque para:
# DATABASE_CLIENT=mysql
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=
# DATABASE_USERNAME=
# DATABASE_PASSWORD=
# DATABASE_SSL=false

# Produção: domínio(s) do site autorizado(s) a chamar a API (separe por vírgula)
# CORS_ORIGIN=https://seudominio.com.br
