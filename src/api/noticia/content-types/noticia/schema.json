{
  "kind": "collectionType",
  "collectionName": "noticias",
  "info": {
    "singularName": "noticia",
    "pluralName": "noticias",
    "displayName": "Notícia"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "titulo": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "titulo" },
    "resumo": { "type": "text" },
    "corpo": { "type": "blocks" },
    "imagem": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "data": { "type": "date", "required": true },
    "destaque": { "type": "boolean", "default": false },
    "fontes": { "type": "component", "repeatable": true, "component": "shared.link" }
  }
}
